# Copy to .env.local for local development. Never commit real values.
# On Cloud Run, set these as env vars / Secret Manager secrets.

# Admin login
ADMIN_PASSWORD=
SESSION_SECRET=

# Firestore (leave USE_FIRESTORE unset locally to use content/*.json only)
USE_FIRESTORE=
GOOGLE_CLOUD_PROJECT=

# Contact form email (e.g. Gmail SMTP with an app password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
